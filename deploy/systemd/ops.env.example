# /etc/plasma/ops.env (root:root, mode 600). Read by the plasma-* systemd units only.
# Never commit the real file; never paste its values into chat or logs.

# Compose project of the production stack (the checkout directory name).
PROD_COMPOSE_PROJECT=plasmaos

# ---- off-host backups (docs/ops/BACKUPS.md) ----
BACKUP_REMOTE=r2://<bucket>/plasma
BACKUP_S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=<R2 API token access key id>
BACKUP_S3_SECRET_ACCESS_KEY=<R2 API token secret>
# BACKUP_S3_TOOL=rclone            # or aws; default: rclone if installed
# BACKUP_DAILY_KEEP=14
# BACKUP_WEEKLY_KEEP=4
# BACKUP_WEEKLY_TENDER_DOCUMENTS=0  # 1 adds /app/data (tender documents) to the weekly set

# ---- alerts (docs/ops/HOST_SETUP.md) ----
OPS_TELEGRAM_BOT_TOKEN=<bot token from @BotFather>
OPS_TELEGRAM_CHAT_ID=<chat id>
OPS_HOST_LABEL=plasma-prod
# MONITOR_DISK_PERCENT=85
# MONITOR_BACKEND_URL=http://127.0.0.1:8000
