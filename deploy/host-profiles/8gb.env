# Host profile 8gb: Hetzner resize target (8 GB RAM / 80 GB disk).
# Select it with HOST_PROFILE=8gb in .env; scripts/compose-release.sh (and
# compose-staging.sh with .env.staging) loads this file after .env, so these values win.
#
# mem_limit = memswap_limit (no container swap). Roomier limits for document parsing
# and two concurrent pursuit analyses; oom_score_adj still decides the victim under
# host memory pressure.
#
#   service                    limit
#   clamav                     2048m
#   backend                     768m
#   celery_worker               768m
#   worker_private_documents    768m
#   worker_pursuit_analysis     768m  (concurrency 2)
#   worker_heavy                512m
#   frontend                    384m
#   celery_beat                 256m
#   sum of limits              6272m  (6.13 GiB) + PostgreSQL + Redis, unlimited
HOST_PROFILE=8gb

PLASMA_MEM_CLAMAV=2048m
PLASMA_MEM_BACKEND=768m
PLASMA_MEM_FRONTEND=384m
PLASMA_MEM_CELERY_WORKER=768m
PLASMA_MEM_WORKER_HEAVY=512m
PLASMA_MEM_WORKER_PRIVATE_DOCUMENTS=768m
PLASMA_MEM_WORKER_PURSUIT_ANALYSIS=768m
PLASMA_MEM_CELERY_BEAT=256m

# Celery --max-memory-per-child, in KiB (see 4gb.env).
PLASMA_CHILD_KB_CELERY_WORKER=307200
PLASMA_CHILD_KB_WORKER_HEAVY=327680
PLASMA_CHILD_KB_WORKER_PRIVATE_DOCUMENTS=524288
PLASMA_CHILD_KB_WORKER_PURSUIT_ANALYSIS=307200

PURSUIT_ANALYSIS_WORKER_CONCURRENCY=2

# PostgreSQL: still conservative for a ~0.2 GB database.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
PG_MAX_CONNECTIONS=100
