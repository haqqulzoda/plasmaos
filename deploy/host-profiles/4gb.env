# Host profile 4gb: Hetzner 2 vCPU / 3.7 GiB RAM / 38 GB disk (production today).
# Select it with HOST_PROFILE=4gb in .env; scripts/compose-release.sh (and
# compose-staging.sh with .env.staging) loads this file after .env, so these values win.
#
# mem_limit = memswap_limit (no container swap). Values are the measured steady-state
# resident memory +~50%, rounded up to a 32 MiB step; ClamAV is sized for its signature
# reload peak (~1.3 GiB), not its steady state. Limits are ceilings: the sum of all
# ceilings plus unlimited PostgreSQL/Redis may exceed physical RAM because services do
# not peak together; oom_score_adj decides which process the kernel kills if they do.
#
#   service                    measured   limit
#   clamav                     0.85 GiB   1536m  (reload peak ~1.3 GiB)
#   celery_worker              0.23 GiB    384m
#   backend                    0.19 GiB    320m
#   worker_pursuit_analysis    0.18 GiB    288m  (concurrency 1)
#   worker_private_documents   0.17 GiB    384m  (raised: document parsing peaks)
#   worker_heavy               0.12 GiB    256m  (raised: archive downloads peak)
#   celery_beat                0.10 GiB    160m
#   frontend                   0.08 GiB    128m
#   sum of limits                         3456m  (3.38 GiB) + PostgreSQL + Redis, unlimited
HOST_PROFILE=4gb

PLASMA_MEM_CLAMAV=1536m
PLASMA_MEM_BACKEND=320m
PLASMA_MEM_FRONTEND=128m
PLASMA_MEM_CELERY_WORKER=384m
PLASMA_MEM_WORKER_HEAVY=256m
PLASMA_MEM_WORKER_PRIVATE_DOCUMENTS=384m
PLASMA_MEM_WORKER_PURSUIT_ANALYSIS=288m
PLASMA_MEM_CELERY_BEAT=160m

# Celery --max-memory-per-child, in KiB: a pool process whose resident memory exceeds
# this after a task is replaced before the next task (it is not killed mid-task).
# Sized below (limit - parent process) / concurrency.
PLASMA_CHILD_KB_CELERY_WORKER=131072
PLASMA_CHILD_KB_WORKER_HEAVY=98304
PLASMA_CHILD_KB_WORKER_PRIVATE_DOCUMENTS=163840
PLASMA_CHILD_KB_WORKER_PURSUIT_ANALYSIS=163840

PURSUIT_ANALYSIS_WORKER_CONCURRENCY=1

# PostgreSQL (database ~0.2 GB): conservative; changing these restarts the db container.
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=1GB
PG_WORK_MEM=4MB
PG_MAINTENANCE_WORK_MEM=64MB
PG_MAX_CONNECTIONS=100
