# Integrity-sealed SQL and executable shell scripts must retain LF bytes even
# when the workspace is checked out with core.autocrlf enabled.
backend/db/baselines/*.sql text eol=lf
backend/db/baselines/*.json text eol=lf
backend/scripts/*.sh text eol=lf
scripts/*.sh text eol=lf
scripts/ops/* text eol=lf
deploy/caddy/Caddyfile text eol=lf
deploy/clamav/*.sh text eol=lf
deploy/systemd/* text eol=lf
deploy/compose/* text eol=lf
# B1: the accepted terms text is hashed; keep the same bytes on every checkout.
backend/app/legal/*.md text eol=lf
docs/legal/*.md text eol=lf
