# ============================================================================
# Plasma AI - STAGING environment (copy to .env.staging; never commit that file)
# ============================================================================
# Used ONLY with scripts/ops/compose-staging.sh (docker compose --env-file
# .env.staging -p plasma_staging ...). Compose then reads this file for both
# interpolation and container environment, and never reads production's .env.
#
# ISOLATION RULES
#  * Every secret below must be DIFFERENT from production's: database password,
#    SECRET_KEY, AUTH_SECRET, AUTH_BRIDGE_SECRET, Google OAuth client, Telegram
#    bot token and GEMINI_API_KEY (its own key with its own budget cap).
#  * Generate secrets with:  openssl rand -base64 48 | tr -d '\n='
#  * scripts/ops/compose-staging.sh refuses to start while a value still
#    contains CHANGE_ME, or when a secret equals the one in production's .env.
# ============================================================================

# ---- Environment -----------------------------------------------------------
# Staging runs the production configuration profile (HTTPS-only CORS origins,
# secret length checks, dangerous flags refused) so it behaves like production.
ENVIRONMENT=production

# ---- Public hostnames (placeholders) ---------------------------------------
# App host serves the Next.js frontend; API host serves the FastAPI backend.
APP_DOMAIN=staging.example.com
API_DOMAIN=api-staging.example.com
ACME_EMAIL=ops@example.com
# Use Let's Encrypt's staging CA while first testing new domains:
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
PROXY_CONTAINER_NAME=plasma_staging_caddy
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# ---- Frontend / auth --------------------------------------------------------
# Must equal https://<APP_DOMAIN>; the staging Google OAuth client must list
# https://<APP_DOMAIN>/api/auth/callback/google as an authorized redirect URI.
NEXTAUTH_URL=https://staging.example.com
AUTH_SECRET=CHANGE_ME_staging_auth_secret_min_32_chars
# Shared by frontend and backend, at least 32 characters.
AUTH_BRIDGE_SECRET=CHANGE_ME_staging_bridge_secret_min_32_chars
GOOGLE_CLIENT_ID=CHANGE_ME_staging_google_client_id
GOOGLE_CLIENT_SECRET=CHANGE_ME_staging_google_client_secret
# Same-origin API path; the Next.js server rewrites it to the backend.
FRONTEND_NEXT_PUBLIC_API_URL=/api/v1

# ---- Backend core ------------------------------------------------------------
SECRET_KEY=CHANGE_ME_staging_secret_key_min_32_chars
# JSON list of explicit HTTPS origins (no paths, no wildcards).
BACKEND_CORS_ORIGINS='["https://staging.example.com","https://api-staging.example.com"]'
TELEGRAM_BOT_TOKEN=CHANGE_ME_separate_staging_bot_token
# Comma-separated allowlists of staging admin/operator emails.
PLASMA_ADMIN_EMAILS=admin@example.com
PLASMA_OPERATOR_EMAILS=operator@example.com

# ---- Database (staging's own Postgres container and volume) -------------------
POSTGRES_USER=plasma
POSTGRES_PASSWORD=CHANGE_ME_staging_db_password
POSTGRES_DB=plasma_ai
# POSTGRES_SERVER / POSTGRES_PORT / CELERY_* / AUTH_REPLAY_REDIS_URL are set by
# Compose to the staging service names (db, redis) and need not be listed here.

# ---- Host ports (loopback only; distinct from production's 6543/6379/8000/3000/5050)
STAGING_DB_PORT=16543
STAGING_REDIS_PORT=16379
STAGING_BACKEND_PORT=18000
STAGING_FRONTEND_PORT=13000
STAGING_PGADMIN_PORT=15050

# ---- AI provider (SEPARATE key and budget from production) -------------------
GEMINI_API_KEY=CHANGE_ME_separate_staging_gemini_key

# Pursuit analysis (D1 build; ignored by older builds).
# Routing: packs of at most GEMINI_PURSUIT_LONG_PACK_CHARS use the SHORT route.
GEMINI_PURSUIT_LONG_PACK_CHARS=60000
GEMINI_PURSUIT_MODEL=gemini-3.8-flash
GEMINI_PURSUIT_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.1-pro-preview
GEMINI_PURSUIT_LONG_MODEL=gemini-3.1-pro-preview
GEMINI_PURSUIT_LONG_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_PURSUIT_MODEL_TIMEOUTS=gemini-3.1-pro-preview=150
GEMINI_PURSUIT_TIMEOUT_SECONDS=90
GEMINI_PURSUIT_MAX_OUTPUT_TOKENS=32768
GEMINI_PURSUIT_CHUNK_CHARS=100000
GEMINI_PURSUIT_LONG_CHUNK_CHARS=100000
PURSUIT_ANALYSIS_CHUNK_CONCURRENCY=3
PURSUIT_ANALYSIS_CHUNK_BUDGET_SECONDS=240
PURSUIT_ANALYSIS_RUN_BUDGET_SECONDS=900
PURSUIT_ANALYSIS_WORKER_CONCURRENCY=2

# Scheduled source refresh (D1-04): once a day per source on staging, to spare the
# live sources. Empty disables it; an unknown or hidden (adb) source fails startup.
SOURCE_REFRESH_SCHEDULE=world_bank=24h,uzex=24h,ebrd=24h,giz=24h

# Other AI/extraction settings (all optional; defaults are in the code).
# GEMINI_REQUIREMENT_MODEL=
# GEMINI_MODEL=
# GEMINI_EXTRACTION_MODEL=
# GEMINI_REQUIREMENT_MAX_PAYLOAD_CHARS=120000
# GEMINI_REQUIREMENT_CHUNK_CONCURRENCY=3

# ---- Background work (optional) ---------------------------------------------
# WORLD_BANK_AUTODRAIN_BATCH_SIZE=25
# WORLD_BANK_AUTODRAIN_INTERVAL_SECONDS=60
# WORLD_BANK_ENRICHMENT_RETRY_BACKOFF_SECONDS=900
# PRIVATE_DOCUMENT_OCR_MAX_PAGES=25

# ---- Build identity (compose-staging.sh sets these from git; override only if needed)
# PLASMA_BUILD_SHA=
# PLASMA_BUILD_TIME=

# ---- pgAdmin (only with `--profile tools`; never started by default) ---------
PGADMIN_DEFAULT_EMAIL=dba@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_staging_pgadmin_password

# ---- Ops scripts (scripts/ops/*) ---------------------------------------------
# Where restore_to_staging.sh looks for the latest production backup set.
BACKUP_SRC_DIR=./backups
