# Copy to .env and supply secrets locally. Never commit populated values.
ENVIRONMENT=production
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=plasma
POSTGRES_DB=plasma_ai
POSTGRES_PASSWORD=
SECRET_KEY=
AUTH_SECRET=
AUTH_BRIDGE_SECRET=
AUTH_REPLAY_REDIS_URL=redis://redis:6379/0
BACKEND_CORS_ORIGINS=["https://console.plasmaos.uz"]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
AUTO_CREATE_TABLES=false
DEMO_OCR_BYPASS=false
PLASMA_ENABLE_PSEUDO_LOCALE=false
# Only needed when explicitly starting the development pgAdmin profile.
PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
