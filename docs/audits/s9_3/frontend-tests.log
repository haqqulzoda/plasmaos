      const view: ExplorerView =
        rawView === "recommended" || rawView === "dismissed" ? rawView : "all";
      const rawStatus = (params.get("status") || "OPEN").toUpperCase();
      const lifecycleStatus = LIFECYCLE_STATUSES.some(
